# Training only. Practice reads .env and is unchanged by this file.
# Copy to .env_training. Each role is local or grok.
# local needs a base URL and a model name. grok needs an API key.
# An empty grok key falls back to XAI_API_KEY in the shell.

# The simulated talk: subject card and Buddy's lines in the training loop.
BACKEND_SIM_TALK=local
SIM_TALK_BASE_URL=http://127.0.0.1:11434/v1
SIM_TALK_MODEL=qwen3:8b
SIM_TALK_API_KEY=
# Same levels as LLM_THINK. Empty uses LLM_THINK from the shell, then the backend default.
SIM_TALK_THINK=

# The judge and the proposer.
BACKEND_JUDGE_PROPOSER=grok
JUDGE_PROPOSER_BASE_URL=https://api.x.ai/v1
JUDGE_PROPOSER_MODEL=grok-4.7
JUDGE_PROPOSER_API_KEY=
JUDGE_PROPOSER_THINK=
