# Copy to .env. Leave secrets empty in git.

# LogosCat. dev is http://localhost:8080. prod is https://logoscat.com.
# The hub container reaches dev through host.docker.internal.
MODE=dev

XAI_API_KEY=
LLM_BACKEND=local
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:8b
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
# OpenAI, an option beside Grok for the buddy (LLM_BACKEND=openai), Bob, Rob, and Wren (*_BACKEND=openai).
# The Settings page, Models tab (#/settings/models), can hold the keys and choose per element; a value saved there wins.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Empty is gpt-5-mini. The Models tab lists the ids your key can use.
OPENAI_MODEL=
# Think level for the practice buddy.
# Local: off, on, low, medium, high, max. Default off.
# OpenAI: none, minimal, low, medium, high, xhigh (the model decides which it accepts).
#   qwen3:8b honors off and on. A named level needs a model that lists it (`ollama show <model>`).
# Grok grok-4.7: low, medium, high, xhigh. Reasoning cannot be off. Leave this empty to use high.
LLM_THINK=off

# Host recognizer, started before compose. It uses the host GPU.
# macOS and Ubuntu: ./scripts/host_whisper.sh
# Windows: .\scripts\host_whisper.ps1
WHISPER_URL=http://host.docker.internal:8082
WHISPER_PORT=8082
WHISPER_CONTROL_URL=http://host.docker.internal:8083
PIPER_VOICE_ID=no_NO-talesyntese-medium
PIPER_MODEL_DIR=/models/piper

AUDIO_ENGINE_URL=http://audio-engine:8081
SQLITE_PATH=/data/logoskittens.db
COMPARISON_LOG=/data/llm-comparison.jsonl

# Buddy out-brain. Empty values keep config/bob.json.
# The shipped backend is xai: https://api.x.ai/v1, model grok-4.7, think low.
# BOB does not read LLM_BACKEND. BOB_BACKEND may be xai or openai. The key is BOB_API_KEY, or XAI_API_KEY / OPENAI_API_KEY when that is empty.
# BOB_ENABLED=off skips the call. BOB_EVERY=3 asks after every third buddy line.
# BOB_QA=on shows the suggestion on the page.
BOB_ENABLED=
BOB_BACKEND=
BOB_BASE_URL=
BOB_MODEL=
BOB_THINK=
BOB_TIMEOUT=
BOB_QA=
BOB_API_KEY=
BOB_STEER_MAX_CHARS=
BOB_EVERY=

# The pose the attached buddy plays when her recording reaches the hub, before the reply.
# Empty means curiosity. off sends nothing.
LISTEN_POSE=

# Talking-game orchestrator. Empty values keep config/wren.json.
# The shipped backend is xai: https://api.x.ai/v1, model grok-4.7, think low.
# Wren does not read LLM_BACKEND. WREN_BACKEND may be xai or openai. The key is WREN_API_KEY, or XAI_API_KEY / OPENAI_API_KEY when that is empty.
# WREN_ENABLED=off refuses a game that calls Wren and leaves free speech runnable.
WREN_ENABLED=
WREN_BACKEND=
WREN_BASE_URL=
WREN_MODEL=
WREN_THINK=
WREN_TIMEOUT=
WREN_API_KEY=

# Masha's attach token. config/players.json names this variable.
# 32 characters or more. Leave it empty in git. An empty value refuses the attach.
MASHA_ATTACH_TOKEN=

# Savelij's attach token. config/players.json names this variable.
# 32 characters or more. Leave it empty in git. An empty value refuses the attach.
SAVELIJ_ATTACH_TOKEN=
