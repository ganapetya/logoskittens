# Speech recognition only. The buddy model stays in .env.
# Copy to .env_recognition, or edit this file. The launcher reads .env_recognition
# when that file exists, and this example otherwise.
# Restart the recognizer after a change:
#   macOS and Ubuntu: ./scripts/host_whisper.sh
#   Windows: .\scripts\host_whisper.ps1
#
# RECOGNITION_MODEL is a whisper.cpp weight. The file is ggml-<name>.bin from
# https://huggingface.co/ggerganov/whisper.cpp
#
# English-only, smaller to larger. A .en model is a bit better at English than
# the multilingual model of the same size.
#   tiny.en      39 M     75 MB
#   base.en      74 M    142 MB    previous default
#   small.en    244 M    466 MB
#   medium.en   769 M    1.5 GB
#
# Multilingual, smaller to larger. There is no English-only large.
#   tiny         39 M     75 MB
#   base         74 M    142 MB
#   small       244 M    466 MB
#   medium      769 M    1.5 GB
#   large-v1    1.55 B   2.9 GB
#   large-v2    1.55 B   2.9 GB
#   large-v3    1.55 B   2.9 GB    most accurate full model
#   large-v3-turbo  809 M  1.5 GB  distilled large-v3, close to that quality, faster
#
# Quantized copies are smaller and a little less accurate. Use the same name
# plus a suffix that exists for that model:
#   -q5_1 or -q8_0 on tiny, tiny.en, base, base.en, small, small.en
#   -q5_0 or -q8_0 on medium, medium.en, large-v2, large-v3-turbo
#   -q5_0 on large-v3
#   examples: small.en-q8_0, medium.en-q5_0, large-v3-turbo-q5_0, large-v3-q5_0
#
# Norwegian Bokmål is not this setting. The Norsk pack uses NbAiLab nb-whisper-large.
#
# Threads for whisper-server. Empty keeps 10.
# RECOGNITION_THREADS=10

RECOGNITION_MODEL=small.en
